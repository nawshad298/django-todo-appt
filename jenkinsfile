pipeline {
    agent any

    environment {
        // Change 'your-dockerhub-username' to your actual Docker Hub ID
        DOCKER_IMAGE = "nawshad298/django-todo-app"
        DOCKER_TAG = "${env.BUILD_ID}"
        DOCKER_CREDS_ID = "KGNW-VHRS"
    }

    stages {
        stage('Clone Repository') {
            steps {
                // Ensure 'master' matches your GitHub branch name
                git branch: 'master', url: 'https://github.com/nawshad298/django-todo-appt.git'
            }
        }

        stage('Build Docker Image') {
    steps {
        script {
            // This will now succeed because the 'migrate' command is moved to CMD
            sh "docker build -t ${DOCKER_IMAGE}:${DOCKER_TAG} ."
            sh "docker tag ${DOCKER_IMAGE}:${DOCKER_TAG} ${DOCKER_IMAGE}:latest"
        }
    }
}

        stage('Push to Docker Hub') {
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: "${DOCKER_CREDS_ID}", passwordVariable: 'PASS', usernameVariable: 'USER')]) {
                        sh "echo \$PASS | docker login -u \$USER --password-stdin"
                        sh "docker push ${DOCKER_IMAGE}:${DOCKER_TAG}"
                        sh "docker push ${DOCKER_IMAGE}:latest"
                    }
                }
            }
        }

        stage('Cleanup') {
            steps {
                // Cleanup local images to save disk space on the Jenkins server
                sh "docker rmi ${DOCKER_IMAGE}:${DOCKER_TAG} ${DOCKER_IMAGE}:latest || true"
            }
        }
    }
}
